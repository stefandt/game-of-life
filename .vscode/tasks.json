{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure clang-debug",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\cmake_with_vsdev.cmd",
            "args": [
                "--preset",
                "clang-debug"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: build clang-debug",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\cmake_with_vsdev.cmd",
            "args": [
                "--build",
                "--preset",
                "clang-debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake: configure clang-debug"
        },
        {
            "label": "Run debug app",
            "type": "process",
            "command": "${workspaceFolder}\\build\\clang-debug\\live_d.exe",
            "dependsOn": "CMake: build clang-debug",
            "problemMatcher": []
        },
        {
            "label": "CMake: configure clang-release",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\cmake_with_vsdev.cmd",
            "args": [
                "--preset",
                "clang-release"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: build clang-release",
            "type": "process",
            "command": "${workspaceFolder}\\tools\\cmake_with_vsdev.cmd",
            "args": [
                "--build",
                "--preset",
                "clang-release"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "CMake: configure clang-release"
        },
        {
            "label": "Run release app",
            "type": "process",
            "command": "${workspaceFolder}\\build\\clang-release\\live.exe",
            "dependsOn": "CMake: build clang-release",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe build active file",
            "command": "C:\\Program Files\\LLVM\\bin\\clang++.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang-cl.exe build active file",
            "command": "C:\\Program Files\\LLVM\\bin\\clang-cl.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}